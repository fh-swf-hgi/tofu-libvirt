# Kopieren nach terraform.tfvars und anpassen. terraform.tfvars wird nicht eingecheckt.

# Anderer SSH-Schluessel
# ssh_public_key_file = "~/.ssh/id_rsa.pub"

# Lokale Kopie des Cloud-Images statt Download
# base_image = "/var/lib/libvirt/images/debian-13-genericcloud-amd64.qcow2"

# Eigene VM-Liste, z. B. mit einem zweiten Client
# vms = {
#   server  = { role = "server", ip = "10.20.0.10", vcpu = 1, memory_mb = 1024, disk_gb = 10 }
#   client  = { role = "client", ip = "10.20.0.20", vcpu = 1, memory_mb = 1024, disk_gb = 10 }
#   client2 = { role = "client", ip = "10.20.0.21", vcpu = 1, memory_mb = 1024, disk_gb = 10 }
# }
